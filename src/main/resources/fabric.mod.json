{
  "schemaVersion": 1,
  "id": "brinswathe",
  "version": "${version}",
  "name": "Brin's Wathe",
  "description": "Brin's Wathe - adds new roles and balance adjustments to the Wathe mod ecosystem",
  "authors": [
    "202037994@qq.com"
  ],
  "icon": "assets/brinswathe/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.erindax.brinswathe.BrinsWathe"
    ],
    "cardinal-components": [
      "cn.erindax.brinswathe.BrinComponents"
    ],
    "client": [
      "cn.erindax.brinswathe.client.BrinsWatheClient"
    ],
    "voicechat": [
      "cn.erindax.brinswathe.voice.BrinVoiceChatPlugin"
    ]
  },
  "custom": {
    "cardinal-components": [
      "brinswathe:stamina",
      "brinswathe:puppeteer_control",
      "brinswathe:stunt_double",
      "brinswathe:medium",
      "brinswathe:eavesdropper",
      "brinswathe:watchman",
      "brinswathe:trapper",
      "brinswathe:nightmare",
      "brinswathe:illusionist",
      "brinswathe:berserker",
      "brinswathe:archivist",
      "brinswathe:boneharvester",
      "brinswathe:compensator",
      "brinswathe:gambler",
      "brinswathe:penitent",
      "brinswathe:sniper",
      "brinswathe:zhangshi",
      "brinswathe:bomb",
      "brinswathe:mortician",
      "brinswathe:avenger",
      "brinswathe:stalker",
      "brinswathe:cowboy",
      "brinswathe:muzzler_ability",
      "brinswathe:resurrected",
      "brinswathe:custom_winner"
    ]
  },
  "mixins": [
    "brinswathe.mixins.json",
    "brinswathe.stupid_express_compat.mixins.json",
    {
      "config": "brinswathe.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "voicechat": "*",
    "kinswathe": "*",
    "harpymodloader": "*",
    "starexpress": "*",
    "noellesroles": "*"
  }
